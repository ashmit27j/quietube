{
  "manifest_version": 3,
  "name": "Quiet — Distraction Free for YouTube",
  "version": "0.1.0",
  "description": "Hide the feed, sidebar, Shorts and comments on YouTube. 40+ toggles, switchable modes, zero paywall, zero accounts, zero tracking.",
  "minimum_chrome_version": "105",

  "permissions": ["storage", "scripting"],
  "host_permissions": [],
  "optional_host_permissions": ["*://*.youtube.com/*", "*://*.reddit.com/*"],

  "background": {
    "service_worker": "background/service-worker.js"
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Quiet",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "commands": {
    "cycle-mode": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Cycle Quiet mode (Off → Casual → Music → Study)"
    },
    "peek": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Peek: reveal everything for 30 seconds"
    }
  }
}
